<%- include("partials/header") %>

<section class="news-section">

    <div class="container">

        <div class="section-header">

            <h2>Últimas Notícias</h2>

            <p>
                Fica a par de todas as novidades do mundo gaming.
            </p>

        </div>

        <!-- Pesquisa -->

        <div class="search-box">

            <form action="/noticias" method="GET">

                <input
                    type="text"
                    name="pesquisa"
                    placeholder="🔎 Procurar notícias..."
                    value="<%= typeof pesquisa !== 'undefined' ? pesquisa : '' %>"
                >

                <button type="submit">
                    Pesquisar
                </button>

            </form>

        </div>


        <!-- Notícias -->

        <div class="news-grid">

            <% if (noticias.length === 0) { %>

                <p>Nenhuma notícia encontrada.</p>

            <% } else { %>

                <% noticias.forEach(noticia => { %>

                    <a
                        href="/noticias/<%= noticia.id %>"
                        class="news-card"
                    >

                        <div class="news-image">

                            <img
                                src="<%= noticia.imagem %>"
                                alt="<%= noticia.titulo %>"
                            >

                        </div>

                        <div class="news-content">

                            <span class="news-category">
                                <%= noticia.categoria %>
                            </span>

                            <h3 class="news-title">
                                <%= noticia.titulo %>
                            </h3>

                            <p class="news-description">
                                <%= noticia.conteudo.substring(0,150) %>...
                            </p>

                            <div class="news-meta">

                                <span>
                                    <%= noticia.autor %>
                                </span>

                                <span>
                                    <%= noticia.data %>
                                </span>

                            </div>

                        </div>

                    </a>

                <% }) %>

            <% } %>

        </div>


        <!-- Paginação -->

        <% if (totalPaginas > 1) { %>

            <div class="pagination">

                <!-- Página anterior -->

                <% if (pagina > 1) { %>

                    <a
                        href="/noticias?pesquisa=<%= encodeURIComponent(pesquisa) %>&pagina=<%= pagina - 1 %>"
                        class="pagination-button"
                    >
                        ← Anterior
                    </a>

                <% } %>


                <!-- Números -->

                <div class="pagination-numbers">

                    <% for (let i = 1; i <= totalPaginas; i++) { %>

                        <a
                            href="/noticias?pesquisa=<%= encodeURIComponent(pesquisa) %>&pagina=<%= i %>"
                            class="pagination-number <%= i === pagina ? 'active' : '' %>"
                        >
                            <%= i %>
                        </a>

                    <% } %>

                </div>


                <!-- Página seguinte -->

                <% if (pagina < totalPaginas) { %>

                    <a
                        href="/noticias?pesquisa=<%= encodeURIComponent(pesquisa) %>&pagina=<%= pagina + 1 %>"
                        class="pagination-button"
                    >
                        Próxima →
                    </a>

                <% } %>

            </div>

        <% } %>

    </div>

</section>

<%- include("partials/footer") %>