<%- include("partials/header") %>

<section class="hero">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <span class="hero-badge">
            🎮 Portal Gaming Nº1 em Portugal
        </span>

        <h1>GameTech</h1>

        <h2>
            Jogos, Tecnologia e Next-Gen
        </h2>

        <p>
            Notícias, análises, reviews, trailers, hardware e tudo sobre
            PlayStation, Xbox, Nintendo e PC Gaming.
        </p>

        <div class="hero-buttons">

            <a href="/noticias" class="btn btn-primary">
                Explorar Notícias
            </a>

            <a href="/login" class="btn btn-secondary">
                Área de Membros
            </a>

        </div>

    </div>

</section>

<section class="stats-section">

    <div class="container">

        <div class="stats-grid">

            <div class="stat-card">
                <h3>500+</h3>
                <p>Notícias Publicadas</p>
            </div>

            <div class="stat-card">
                <h3>5K+</h3>
                <p>Membros da Comunidade</p>
            </div>

            <div class="stat-card">
                <h3>4</h3>
                <p>Plataformas em Destaque</p>
            </div>

        </div>

    </div>

</section>

<section class="news-section">

    <div class="container">

        <div class="section-header">

            <h2>Últimas Notícias</h2>

            <p>
                Mantém-te atualizado com o mundo gaming.
            </p>

        </div>

        <div class="news-grid">

    <article class="news-card">

        <div class="news-image">
            <img src="/images/gta6.jpg" alt="GTA VI">
        </div>

        <div class="news-content">

            <span class="news-category">
                Rockstar
            </span>

            <h3 class="news-title">
                GTA VI recebe novo trailer
            </h3>

            <p class="news-description">
                A Rockstar revelou novas imagens, detalhes e novidades sobre
                um dos jogos mais aguardados de sempre.
            </p>

            <div class="news-meta">

                <span>13 Jul 2026</span>

                <a href="#" class="news-button">
                    Explorar notícia →
                </a>

            </div>

        </div>

    </article>

    <article class="news-card">

        <div class="news-image">
            <img src="/images/playstation.jpg" alt="PlayStation 6">
        </div>

        <div class="news-content">

            <span class="news-category">
                PlayStation
            </span>

            <h3 class="news-title">
                PlayStation 6 ganha força
            </h3>

            <p class="news-description">
                Novos rumores apontam para hardware revolucionário e exclusivos
                preparados para a próxima geração.
            </p>

            <div class="news-meta">

                <span>12 Jul 2026</span>

                <a href="#" class="news-button">
                    Explorar notícia →
                </a>

            </div>

        </div>

    </article>

    <article class="news-card">

        <div class="news-image">
            <img src="/images/hardware.jpg" alt="Hardware Gaming">
        </div>

        <div class="news-content">

            <span class="news-category">
                Hardware
            </span>

            <h3 class="news-title">
                O melhor PC Gamer de 2026
            </h3>

            <p class="news-description">
                Descobre as melhores placas gráficas, processadores e
                periféricos para jogar em máxima qualidade.
            </p>

            <div class="news-meta">

                <span>11 Jul 2026</span>

                <a href="#" class="news-button">
                    Explorar notícia →
                </a>

            </div>

        </div>

    </section>

<%- include("partials/footer") %>

